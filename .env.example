# =============================================================================
# FinTrack environment variables
# =============================================================================
# Copy to .env for local Docker Compose:  cp .env.example .env
# NEVER commit .env. Values below are safe examples, not real secrets.
#
# Generate strong secrets with:   openssl rand -hex 32
# (Windows without openssl:       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# =============================================================================


# -----------------------------------------------------------------------------
# 1) LOCAL (docker compose up --build) - every variable is optional
# -----------------------------------------------------------------------------
# docker-compose.yml has working local defaults; set these only to override them.
JWT_ACCESS_SECRET=replace-with-64-hex-chars-from-openssl-rand-hex-32
INTERNAL_TOKEN=replace-with-another-64-hex-chars-from-openssl-rand-hex-32
RABBITMQ_USER=fintrack
RABBITMQ_PASSWORD=fintrack_local_pw
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info

# Demo account created by the seed script (docker compose --profile seed run --rm seed)
DEMO_EMAIL=demo@fintrack.local
DEMO_PASSWORD=ChangeMe1234
DEMO_NAME=Demo User


# =============================================================================
# 2) PRODUCTION - which service to use for what
# =============================================================================
#   Frontend ........... Vercel (free)            https://vercel.com
#   Gateway + 3 services Render web services      https://render.com   (free tier sleeps after ~15 min idle)
#   Database ........... MongoDB Atlas M0 (free)  https://www.mongodb.com/atlas
#   Message broker ..... CloudAMQP "Little Lemur" (free RabbitMQ)  https://www.cloudamqp.com
#   Image registry ..... GitHub Container Registry (ghcr.io, free, uses GITHUB_TOKEN)
#   Uptime pings ....... UptimeRobot (free) - keeps Render awake and gives a status badge
#
# Set the variables below in each Render service's "Environment" tab.
# Use the SAME JWT_ACCESS_SECRET in auth-service and gateway.
# Use the SAME INTERNAL_TOKEN in all four backend services.
# -----------------------------------------------------------------------------

# ---- MongoDB Atlas (one free cluster, three databases, three DB users) -------
# Atlas -> Database Access: create 3 users, each with "Read and write to a specific database":
#     fintrack_auth_user  -> fintrack_users
#     fintrack_tx_user    -> fintrack_transactions
#     fintrack_notif_user -> fintrack_notifications
# Atlas -> Network Access: allow 0.0.0.0/0 (Render free tier has no fixed IPs).
# Atlas -> Connect -> Drivers: copy the mongodb+srv:// string and add the database name after the host.
#
#   auth-service:
# MONGO_URI=mongodb+srv://fintrack_auth_user:<password>@<cluster>.mongodb.net/fintrack_users?retryWrites=true&w=majority
#   transaction-service:
# MONGO_URI=mongodb+srv://fintrack_tx_user:<password>@<cluster>.mongodb.net/fintrack_transactions?retryWrites=true&w=majority
#   notification-service:
# MONGO_URI=mongodb+srv://fintrack_notif_user:<password>@<cluster>.mongodb.net/fintrack_notifications?retryWrites=true&w=majority
# (URL-encode special characters in the password, e.g. @ becomes %40)

# ---- CloudAMQP (hosted RabbitMQ) ---------------------------------------------
# Create a "Little Lemur" instance -> copy the "AMQP URL" (starts with amqps://).
# Set it in transaction-service AND notification-service:
# AMQP_URL=amqps://<user>:<password>@<host>.rmq.cloudamqp.com/<vhost>

# ---- Gateway (Render web service) --------------------------------------------
# NODE_ENV=production
# PORT=8080
# JWT_ACCESS_SECRET=<same value as auth-service, 64 hex chars>
# INTERNAL_TOKEN=<shared secret, 64 hex chars>
# AUTH_SERVICE_URL=https://fintrack-auth.onrender.com
# TRANSACTION_SERVICE_URL=https://fintrack-transactions.onrender.com
# NOTIFICATION_SERVICE_URL=https://fintrack-notifications.onrender.com
# CORS_ORIGINS=https://<your-frontend>.vercel.app          # comma-separated, no trailing slash
# RATE_LIMIT_MAX=200                                       # requests per minute per IP (optional)
# AUTH_RATE_LIMIT_MAX=30                                   # login/register/refresh per 15 min per IP (optional)
# PROXY_TIMEOUT_MS=60000                                   # gives sleeping Render services time to wake up

# ---- Auth service ------------------------------------------------------------
# NODE_ENV=production
# PORT=4001
# MONGO_URI=<see MongoDB Atlas above>
# JWT_ACCESS_SECRET=<same value as gateway>
# INTERNAL_TOKEN=<shared secret>
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=7
# COOKIE_SECURE=true          # required on https
# COOKIE_SAMESITE=lax         # keep "lax" when Vercel rewrites /api (same-origin). Use "none" only if the frontend calls the gateway directly cross-origin.
# LOGIN_MAX_ATTEMPTS=5        # failed logins per 15 min per IP+email

# ---- Transaction service -----------------------------------------------------
# NODE_ENV=production
# PORT=4002
# MONGO_URI=<see MongoDB Atlas above>
# AMQP_URL=<see CloudAMQP above>
# INTERNAL_TOKEN=<shared secret>

# ---- Notification service ----------------------------------------------------
# NODE_ENV=production
# PORT=4003
# MONGO_URI=<see MongoDB Atlas above>
# AMQP_URL=<see CloudAMQP above>
# INTERNAL_TOKEN=<shared secret>
# DEFAULT_THRESHOLD=10000     # rupees, used until a user sets their own

# NOTE: Render passes its own PORT. The services read PORT, so leave the Render
# "PORT" variable alone if Render sets one automatically.

# ---- Frontend (Vercel) -------------------------------------------------------
# Recommended: do NOT set VITE_API_URL. Instead edit frontend/vercel.json and replace
# YOUR-GATEWAY-URL with your Render gateway host. Vercel then proxies /api to the gateway,
# so the browser sees one origin and the refresh-token cookie works without cross-site cookie issues.
#
# Alternative (cross-origin): VITE_API_URL=https://<gateway>.onrender.com
#   then also set COOKIE_SAMESITE=none and COOKIE_SECURE=true on auth-service.
#   Some browsers block third-party cookies, so the rewrite approach is more reliable.


# =============================================================================
# 3) CI/CD secrets (GitHub repo -> Settings -> Secrets and variables -> Actions)
# =============================================================================
# GITHUB_TOKEN ............ automatic; the job needs `permissions: packages: write` to push to ghcr.io
# RENDER_DEPLOY_HOOK_GATEWAY, RENDER_DEPLOY_HOOK_AUTH,
# RENDER_DEPLOY_HOOK_TRANSACTION, RENDER_DEPLOY_HOOK_NOTIFICATION
#                           Render -> service -> Settings -> Deploy Hook (create the Render services as
#                           "Deploy an existing image" pointing at ghcr.io/<owner>/<image>:latest;
#                           make the GHCR packages public so Render can pull without credentials)
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
#                           only if you deploy the frontend with the Vercel CLI from Actions
#                           (otherwise Vercel's GitHub integration deploys on every push to main)
# GATEWAY_URL (repo VARIABLE, not secret) .. public gateway URL, e.g. https://fintrack-gateway.onrender.com; used by the post-deploy /health check
# FRONTEND_URL (repo VARIABLE, optional) ..... public frontend URL, also checked after deploy
# (Optional) create a GitHub Environment named "production" - the deploy job uses it.
